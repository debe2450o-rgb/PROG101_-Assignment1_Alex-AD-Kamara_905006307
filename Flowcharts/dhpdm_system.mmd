flowchart TD
    Start([START]) --> Init[Initialize MAX_PATIENTS, arrays, recordCount = 0, and isSystemRunning = TRUE]
    Init --> Running{isSystemRunning == TRUE?}
    Running -- No --> End([END PROGRAM])
    Running -- Yes --> Menu[/Display menu and read menuChoice/]
    Menu --> Choice{menuChoice}
    Choice -- "1: Register" --> Register[[CALL RegisterPatient]]
    Choice -- "2: Search" --> Search[[CALL SearchPatient]]
    Choice -- "3: Update" --> Update[[CALL UpdateRecord]]
    Choice -- "4: Exit" --> Close[/Print "System closed successfully."/]
    Choice -- "Other" --> Invalid[/Print "Invalid selection."/]
    Register --> Running
    Search --> Running
    Update --> Running
    Invalid --> Running
    Close --> End
